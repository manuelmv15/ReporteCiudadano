<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo blanco con mucha transparencia (Glassmorphism) -->
    <solid android:color="#E6FFFFFF" />

    <!-- Borde muy fino y sutil tipo Tailwind border-slate-200/50 -->
    <stroke
        android:width="1dp"
        android:color="#1A000000" />

    <!-- Bordes muy redondeados tipo rounded-full -->
    <corners android:radius="100dp" />
</shape>
