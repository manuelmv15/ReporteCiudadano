<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Outer circle base (shadow effect) -->
    <path
        android:pathData="M 24,24 m -20,0 a 20,20 0 1,0 40,0 a 20,20 0 1,0 -40,0"
        android:fillColor="#20000000" />

    <!-- Main circle (3D effect) -->
    <path
        android:pathData="M 24,24 m -18,0 a 18,18 0 1,0 36,0 a 18,18 0 1,0 -36,0"
        android:fillColor="#2196F3"
        android:strokeColor="#1565C0"
