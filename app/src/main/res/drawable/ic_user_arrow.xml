    <!-- Highlight circle (top-left for 3D) -->
    <path
        android:pathData="M 20,20 m -16,0 a 16,16 0 1,0 32,0 a 16,16 0 1,0 -32,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1"
        android:alpha="0.4" />

    <!-- Arrow shadow (offset down-right for 3D depth) -->
    <path
        android:pathData="M 24.5,6.5 L 32.5,20.5 L 28.5,20.5 L 28.5,38.5 L 20.5,38.5 L 20.5,20.5 L 16.5,20.5 Z"
        android:fillColor="#30000000"
        android:alpha="0.3" />

    <!-- Arrow pointing UP (north) - thick and bold for 3D feel -->
    <path
        android:pathData="M 24,6 L 32,20 L 28,20 L 28,38 L 20,38 L 20,20 L 16,20 Z"
        android:fillColor="#FFFFFF" />

</vector>
