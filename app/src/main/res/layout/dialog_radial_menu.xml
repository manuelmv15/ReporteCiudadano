<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000">

        <View
            android:id="@+id/center_point"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Vialidad (0°) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_vialidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Bache"
            app:srcCompat="@drawable/ic_category_vialidad"
            app:backgroundTint="@color/category_vialidad"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:layout_constraintCircle="@id/center_point"
            app:layout_constraintCircleRadius="120dp"
            app:layout_constraintCircleAngle="0"
            tools:ignore="MissingConstraints" />

        <!-- Alumbrado (60°) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_alumbrado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Alumbrado público"
            app:srcCompat="@drawable/ic_category_alumbrado"
            app:backgroundTint="@color/category_alumbrado"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:layout_constraintCircle="@id/center_point"
            app:layout_constraintCircleRadius="120dp"
            app:layout_constraintCircleAngle="60"
            tools:ignore="MissingConstraints" />

        <!-- Agua (120°) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_agua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Fuga de agua"
            app:srcCompat="@drawable/ic_category_agua"
            app:backgroundTint="@color/category_agua"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:layout_constraintCircle="@id/center_point"
            app:layout_constraintCircleRadius="120dp"
            app:layout_constraintCircleAngle="120"
            tools:ignore="MissingConstraints" />

        <!-- Señalización vial (180°) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_senalizacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Señalización vial"
            app:srcCompat="@drawable/ic_category_senalizacion"
            app:backgroundTint="@color/category_senalizacion"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:layout_constraintCircle="@id/center_point"
            app:layout_constraintCircleRadius="120dp"
            app:layout_constraintCircleAngle="180"
            tools:ignore="MissingConstraints" />

        <!-- Seguridad (240°) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_seguridad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Inseguridad"
            app:srcCompat="@drawable/ic_category_seguridad"
            app:backgroundTint="@color/category_seguridad"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:layout_constraintCircle="@id/center_point"
            app:layout_constraintCircleRadius="120dp"
            app:layout_constraintCircleAngle="240"
            tools:ignore="MissingConstraints" />

        <!-- Basura (300°) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_basura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Basura acumulada"
            app:srcCompat="@drawable/ic_category_basura"
            app:backgroundTint="@color/category_basura"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:layout_constraintCircle="@id/center_point"
            app:layout_constraintCircleRadius="120dp"
            app:layout_constraintCircleAngle="300"
            tools:ignore="MissingConstraints" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
