<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/colorSurfaceContainer"
    android:padding="16dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <ImageView
        android:id="@+id/ivVoteType"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Tipo de voto"
        android:scaleType="centerInside"
        android:tint="?attr/colorPrimary"
        app:srcCompat="@drawable/ic_thumb_up" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvVoteType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sigue ahí"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvVoteReportDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Descripción del reporte"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvVoteDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fecha"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVoteAccuracy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acertado"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_status_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp" />

</LinearLayout>
