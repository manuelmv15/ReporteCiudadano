<?xml version="1.0" encoding="utf-8"?>
<!-- Artículo de la tienda. Según el tipo se muestra una sola de las tres vistas previas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_stat_tile"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="76dp">

        <!-- Vista previa: marco alrededor de tu avatar -->
        <FrameLayout
            android:id="@+id/ringPreview"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:padding="5dp"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPreviewAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorPrimaryContainer"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:srcCompat="@drawable/person_24px" />
        </FrameLayout>

        <!-- Vista previa: título -->
        <TextView
            android:id="@+id/tvPreviewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:maxLines="2"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:visibility="gone" />

        <!-- Vista previa: barra flotante teñida -->
        <LinearLayout
            android:id="@+id/llPreviewBar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_floating_toolbar"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/my_location_24px"
                app:tint="?attr/colorOnSurface" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/add_report"
                app:tint="?attr/colorOnSurface" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/tune_24px"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvItemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="2"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnItemAction"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="8dp"
        android:textAppearance="?attr/textAppearanceLabelLarge" />
</LinearLayout>
